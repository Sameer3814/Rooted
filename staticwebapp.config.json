{
  "routes": [
    { "route": "/.git/*", "statusCode": 404 },
    { "route": "/pipeline/.cache/*", "statusCode": 404 },
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
