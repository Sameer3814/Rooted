{
  "routes": [
    { "route": "/.git/*", "statusCode": 404 },
    { "route": "/pipeline/.cache/*", "statusCode": 404 },
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/api/unreached-of-the-day",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/verse-of-the-day",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/verse-image",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
